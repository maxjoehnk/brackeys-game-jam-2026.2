<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'web' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>BrackeysGameJam2026.Empty</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'web' ">
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup Condition=" '$(GodotTargetPlatform)' != 'web' ">
    <Compile Remove="Program.cs" />
  </ItemGroup>

  <ItemGroup Condition=" '$(GodotTargetPlatform)' == 'web' ">
    <TrimmerRootAssembly Include="$(AssemblyName)" />
    <TrimmerRootAssembly Include="GodotSharp" />
    <TrimmerRootAssembly Include="System.Private.CoreLib" />
    <TrimmerRootAssembly Include="System.Runtime" />
  </ItemGroup>
</Project>
